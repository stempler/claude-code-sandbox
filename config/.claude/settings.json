{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_profile": "permissive",
  "_description": "Broad Python/shell access for data science, ML, and exploratory work. The agent can run arbitrary Python — the egress firewall is the primary defense against exfiltration. Use this when the agent needs to run notebooks, scripts, or data pipelines.",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(hk *)",
      "Bash(mise *)",
      "Edit(/workspace/**)",
      "Write(/workspace/**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pytest *)",
      "Bash(pip list*)",
      "Bash(pip show *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(black *)",
      "Bash(ruff *)"
    ],
    "deny": [
      "Read(/run/secrets/*)",
      "Read(/proc/*)",
      "Read(/etc/shadow)",
      "Bash(cat /proc/*)",
      "Edit(/etc/*)",
      "Edit(.git/**)",
      "Edit(docker-compose*)",
      "Edit(Dockerfile*)",
      "Edit(.env*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(docker *)",
      "Bash(iptables *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(export *)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(chmod *settings*)",
      "Bash(chown *settings*)",
      "Edit(/home/devuser/.claude/*)",
      "Write(/home/devuser/.claude/*)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(npm exec *)",
      "Bash(npx *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f hk.pkl ] && hk fix || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mise trust -a && mise install"
          }
        ]
      }
    ]
  }
}
