#!/bin/bash
# Source sandbox-managed env (proxy, DinD) for docker exec attach sessions.
# /etc/environment is written by entrypoint.sh and is the single source of
# truth for these values. docker exec bypasses PAM and bash is launched
# non-login, so /etc/environment would otherwise never be read.
#
# Format: /etc/environment is only ever shell-sourced in this sandbox, not read
# by PAM, so double-quoted values containing spaces (e.g. JAVA_TOOL_OPTIONS) are
# safe — bash parses the quotes correctly during source.
set -a
[ -f /etc/environment ] && . /etc/environment
set +a
exec "$@"
