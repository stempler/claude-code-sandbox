{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_note": "This is the STRICT profile. See settings-profiles/ for alternatives. To switch: cp settings-profiles/permissive.json claude-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Edit(src/**)",
      "Write(src/**)",
      "Bash(pytest *)",
      "Bash(pytest)",
      "Bash(pip list*)",
      "Bash(pip show *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(black *)",
      "Bash(ruff *)"
    ],
    "deny": [
      "Read(/run/secrets/*)",
      "Read(/proc/*)",
      "Read(/etc/shadow)",
      "Bash(cat /proc/*)",
      "Edit(/etc/*)",
      "Edit(.git/**)",
      "Edit(docker-compose*)",
      "Edit(Dockerfile*)",
      "Edit(.env*)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node *)",
      "Bash(node -e *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(docker *)",
      "Bash(iptables *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(env)",
      "Bash(printenv *)",
      "Bash(export *)",
      "Bash(chmod 777 *)",
      "Bash(dd *)",
      "Bash(chmod *settings*)",
      "Bash(chown *settings*)",
      "Edit(/home/devuser/.claude/*)",
      "Write(/home/devuser/.claude/*)",
      "Bash(pip install *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(npx *)"
    ]
  }
}
