#!/usr/bin/env bash
###############################################################################
# bin/claude-sandbox — Run Claude Code in the sandbox container
#
# Usage:
#   claude-sandbox [--no-build] [-- <command> [args...]]
#
# Options:
#   --no-build   Skip rebuilding the Docker image before running
#
# Examples:
#   claude-sandbox                              # interactive bash shell
#   claude-sandbox -- claude -p "fix the bug" --max-turns 30
#   claude-sandbox --no-build -- bash           # skip rebuild, run immediately
#
# The current working directory is mounted as /workspace inside the container.
# The container is automatically removed when it exits.
###############################################################################

set -euo pipefail

IMAGE_NAME="claude-code-sandbox"
CLAUDE_STATE_VOLUME="claude-state-home"

# Resolve the project root, following symlinks to the real script location
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

WORKSPACE_DIR="$(pwd)"
SKIP_BUILD=false
ENTRYPOINT_OVERRIDE=""

# ── Parse flags ─────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-build)
            SKIP_BUILD=true
            shift
            ;;
        --entrypoint)
            ENTRYPOINT_OVERRIDE="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Usage: claude-sandbox [--no-build] [--entrypoint <cmd>] [-- <command> [args...]]" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Remaining arguments are the container command; default to bash
CMD=("${@:-bash}")

# ── Build image ──────────────────────────────────────────────────────────────
if ! $SKIP_BUILD; then
    echo "[claude-sandbox] Building image '$IMAGE_NAME'..."
    docker build -t "$IMAGE_NAME" "$PROJECT_DIR"
fi

# ── Assemble docker run args ─────────────────────────────────────────────────
DOCKER_ARGS=(
    --rm
    --cap-add NET_ADMIN
    -v "${WORKSPACE_DIR}:/workspace"
    -v "${CLAUDE_STATE_VOLUME}:/home/devuser"
    # -v "${PROJECT_DIR}/gitconfig-sandbox:/home/devuser/.gitconfig:ro"
    -e GIT_AUTHOR_NAME="Claude Code (sandbox)"
    -e GIT_AUTHOR_EMAIL="claude-sandbox@localhost"
    -e GIT_COMMITTER_NAME="Claude Code (sandbox)"
    -e GIT_COMMITTER_EMAIL="claude-sandbox@localhost"
    -w /workspace
    --pids-limit 100
    --memory 4g
    --cpus 2.0
)

if [ -n "$ENTRYPOINT_OVERRIDE" ]; then
    DOCKER_ARGS+=(--entrypoint "$ENTRYPOINT_OVERRIDE")
fi

# Attach TTY flags only when both stdin and stdout are a terminal.
# Checking stdout prevents stalling when output is captured (e.g. $(...)).
if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_ARGS+=(-it)
fi

# ── Run ──────────────────────────────────────────────────────────────────────
echo "[claude-sandbox] Starting sandbox in: $WORKSPACE_DIR"
exec docker run "${DOCKER_ARGS[@]}" "$IMAGE_NAME" "${CMD[@]}"
