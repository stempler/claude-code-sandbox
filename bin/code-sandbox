#!/usr/bin/env bash
###############################################################################
# bin/code-sandbox — Run Claude Code / OpenCode in the sandbox container
#
# Usage:
#   code-sandbox [--no-build] [--enable-docker | --no-docker] [--non-interactive] [-- <command> [args...]]
#
# Options:
#   --no-build        Skip rebuilding the Docker image before running
#   --enable-docker   Enable rootless Podman inside the sandbox for tasks that
#                     need Docker (testcontainers, image builds, compose stacks).
#                     Inner containers are isolated and go through the same
#                     egress firewall as the agent. Increases PIDs (512) and
#                     memory (8g) limits.
#   --no-docker       Explicitly run without Docker. Skips the interactive mode
#                     prompt.
#   --non-interactive Skip the interactive mode prompt and use the default
#                     (no Docker) unless a mode flag is also given. Used by the
#                     test suite and scripted invocations.
#
# When starting a fresh container without a mode flag, an interactive prompt
# asks whether to enable Docker. The prompt is skipped when a mode flag or
# --non-interactive is given, or when stdin/stdout is not a terminal.
#
# Examples:
#   code-sandbox                              # prompts for mode, then bash shell
#   code-sandbox -- claude -p "fix the bug" --max-turns 30
#   code-sandbox --no-build -- bash           # skip rebuild, run immediately
#   code-sandbox --enable-docker -- bash      # shell with Docker (Podman) access
#   code-sandbox --non-interactive -- bash    # no prompt, default (no Docker)
#
# The current working directory is mounted as /workspace inside the container.
# The container is automatically removed when it exits.
###############################################################################

set -euo pipefail

IMAGE_NAME="claude-code-sandbox"
CLAUDE_STATE_VOLUME="claude-state-home"

# Resolve the project root, following symlinks to the real script location
REAL_SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

WORKSPACE_DIR="$(pwd)"
SKIP_BUILD=false
ENABLE_DOCKER=false
MODE_EXPLICIT=false
NON_INTERACTIVE=false
_ENABLE_DOCKER_SEEN=false
_NO_DOCKER_SEEN=false
ENTRYPOINT_OVERRIDE=""

# Deterministic container name based on workspace path (allows reuse detection).
# SANDBOX_CONTAINER_NAME overrides it — e.g. the test suite sets a dedicated name
# so its throwaway container never collides with (or destroys) a real sandbox
# already running for the same workspace.
CONTAINER_NAME="${SANDBOX_CONTAINER_NAME:-claude-sandbox-$(echo "$WORKSPACE_DIR" | md5sum | cut -c1-12)}"
SANDBOX_DOMAINS_FILE="$WORKSPACE_DIR/.sandbox-domains"
SANDBOX_CREDENTIALS_FILE="$WORKSPACE_DIR/.sandbox-secrets.yaml"

# ── Parse flags ─────────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-build)
            SKIP_BUILD=true
            shift
            ;;
        --enable-docker)
            ENABLE_DOCKER=true
            MODE_EXPLICIT=true
            _ENABLE_DOCKER_SEEN=true
            shift
            ;;
        --no-docker)
            ENABLE_DOCKER=false
            MODE_EXPLICIT=true
            _NO_DOCKER_SEEN=true
            shift
            ;;
        --non-interactive)
            NON_INTERACTIVE=true
            shift
            ;;
        --entrypoint)
            ENTRYPOINT_OVERRIDE="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Usage: code-sandbox [--no-build] [--enable-docker | --no-docker] [--non-interactive] [--entrypoint <cmd>] [-- <command> [args...]]" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

# Reject contradictory mode flags
if [[ "$_ENABLE_DOCKER_SEEN" == "true" ]] && [[ "$_NO_DOCKER_SEEN" == "true" ]]; then
    echo "[code-sandbox] ERROR: --enable-docker and --no-docker are mutually exclusive." >&2
    exit 1
fi

# Remaining arguments are the container command; default to bash
CMD=("${@:-bash}")

# ── Credential resolver ──────────────────────────────────────────────────────
CRED_TMPDIR=""
_cred_cleanup() { [ -n "$CRED_TMPDIR" ] && rm -rf "$CRED_TMPDIR"; return 0; }
trap _cred_cleanup EXIT

resolve_credentials() {
    [ -f "$SANDBOX_CREDENTIALS_FILE" ] || return 0

    if ! command -v yq > /dev/null 2>&1; then
        echo "[code-sandbox] ERROR: 'yq' is required for .sandbox-secrets.yaml but not found."
        echo "[code-sandbox]   Install: brew install yq  OR  snap install yq  OR  go install github.com/mikefarah/yq/v4@latest"
        exit 1
    fi
    if ! command -v jq > /dev/null 2>&1; then
        echo "[code-sandbox] ERROR: 'jq' is required for .sandbox-secrets.yaml but not found."
        echo "[code-sandbox]   Install: brew install jq  OR  apt install jq"
        exit 1
    fi

    CRED_TMPDIR=$(mktemp -d)

    # Resolve each secret by executing its source command on the host
    local secret_names
    secret_names=$(yq '.secrets | keys | .[]' "$SANDBOX_CREDENTIALS_FILE")

    local secrets_json="{}"
    while IFS= read -r name; do
        # Skip empty lines (e.g. when secrets block is empty)
        [ -n "$name" ] || continue
        local source_cmd
        # Use bracket notation to handle key names containing dots or hyphens
        source_cmd=$(yq ".secrets[\"${name}\"].source" "$SANDBOX_CREDENTIALS_FILE")
        local value err_output
        err_output=$(mktemp)
        value=$(bash -c "$source_cmd" 2>"$err_output") || {
            local exit_code=$?
            echo "[code-sandbox] ERROR: credential source for '$name' failed (exit $exit_code):"
            echo "[code-sandbox]   Command: $source_cmd"
            [ -s "$err_output" ] && echo "[code-sandbox]   Output: $(cat "$err_output")"
            rm -f "$err_output"
            exit 1
        }
        rm -f "$err_output"
        # Trim all newlines (embedded newlines are also removed).
        # Note: multi-line values such as PEM keys are not supported.
        value=$(printf '%s' "$value" | tr -d '\n')
        secrets_json=$(printf '%s' "$secrets_json" | jq --arg k "$name" --arg v "$value" '. + {($k): $v}')
    done <<< "$secret_names"

    # Convert targets YAML to JSON (yq handles mixed string/object entries natively)
    local targets_json
    targets_json=$(yq -o=json '.targets' "$SANDBOX_CREDENTIALS_FILE")

    # Write payload.json
    jq -n --argjson s "$secrets_json" --argjson t "$targets_json" \
       '{"secrets": $s, "targets": $t}' > "$CRED_TMPDIR/payload.json"

    # Build deny-rules.json — prevent Claude from reading injected secret files
    local deny_rules
    deny_rules=$(printf '%s' "$targets_json" | jq '[.[].dest | . as $d | [
        "Read(\($d))",
        "Bash(cat \($d)*)",
        "Bash(grep * \($d)*)",
        "Bash(head * \($d)*)",
        "Bash(tail * \($d)*)",
        "Bash(python * \($d)*)",
        "Bash(python3 * \($d)*)"
    ] | .[]] | unique')
    printf '%s' "$deny_rules" > "$CRED_TMPDIR/deny-rules.json"

    # Mount the credential payload into the container via tmpfs
    DOCKER_ARGS+=(
        --mount "type=tmpfs,destination=/run/sandbox-secrets,tmpfs-mode=0700,tmpfs-size=1048576"
        -v "$CRED_TMPDIR/payload.json:/run/sandbox-secrets/payload.json:ro"
        -v "$CRED_TMPDIR/deny-rules.json:/run/sandbox-secrets/deny-rules.json:ro"
        -e SANDBOX_CREDENTIALS=true
    )

    local secret_count target_count
    secret_count=$(printf '%s' "$secrets_json" | jq 'length')
    target_count=$(printf '%s' "$targets_json" | jq 'length')
    echo "[code-sandbox] Resolved $secret_count credential(s) for $target_count target(s)"
}

# ── Build image ──────────────────────────────────────────────────────────────
if ! $SKIP_BUILD; then
    echo "[code-sandbox] Building image '$IMAGE_NAME'..."
    docker build -t "$IMAGE_NAME" "$PROJECT_DIR"
fi

# ── Git identity: inherit from host git config, fall back to sandbox defaults ─
GIT_USER_NAME="$(git config user.name 2>/dev/null || echo "Claude Code (sandbox)")"
GIT_USER_EMAIL="$(git config user.email 2>/dev/null || echo "claude-sandbox@localhost")"

# ── Reuse running container for this workspace ───────────────────────────────
# If no entrypoint override is requested and a container is already running for
# this workspace, exec into it as devuser instead of starting a new one.
if [ -z "$ENTRYPOINT_OVERRIDE" ] && \
   docker ps --filter "name=^${CONTAINER_NAME}$" --format '{{.ID}}' | grep -q .; then
    echo "[claude-sandbox] Attaching to running container for: $WORKSPACE_DIR"
    [ -f "$SANDBOX_CREDENTIALS_FILE" ] && \
        echo "[code-sandbox] NOTE: reusing existing container — credential changes in .sandbox-secrets.yaml are not applied until the container is recreated."
    EXEC_ARGS=(--user devuser -w /workspace)
    if [ -t 0 ] && [ -t 1 ]; then
        EXEC_ARGS+=(-it)
    fi
    EXEC_ARGS+=(-e TERM="${TERM:-xterm-256color}")
    EXEC_ARGS+=(-e GIT_AUTHOR_NAME="$GIT_USER_NAME")
    EXEC_ARGS+=(-e GIT_AUTHOR_EMAIL="$GIT_USER_EMAIL")
    EXEC_ARGS+=(-e GIT_COMMITTER_NAME="$GIT_USER_NAME")
    EXEC_ARGS+=(-e GIT_COMMITTER_EMAIL="$GIT_USER_EMAIL")
    # sandbox-exec sources /etc/environment (proxy, DinD vars) before exec'ing
    # the command, since docker exec bypasses PAM and skips /etc/profile.
    exec docker exec "${EXEC_ARGS[@]}" "$CONTAINER_NAME" \
        /usr/local/bin/sandbox-exec "${CMD[@]}"
fi

# ── Interactive mode selection (fresh container only) ────────────────────────
# Reached only when NOT attaching to a running container (the block above
# exec's away when it attaches). Prompt only when mode was not chosen via flag,
# --non-interactive was not passed, and we have an interactive terminal.
if [[ "$MODE_EXPLICIT" == "false" ]] && [[ "$NON_INTERACTIVE" == "false" ]] \
   && [ -t 0 ] && [ -t 1 ]; then
    while true; do
        echo "Select sandbox mode:"
        echo "  1) No Docker (default)"
        echo "  2) Docker (Podman) enabled"
        # `read` returns non-zero on EOF; guard so `set -e` doesn't abort.
        read -r -p "Choice [1]: " _mode_choice || _mode_choice=""
        case "$_mode_choice" in
            ""|1)
                ENABLE_DOCKER=false
                break
                ;;
            2)
                ENABLE_DOCKER=true
                break
                ;;
            *)
                echo "[code-sandbox] Please enter 1 or 2." >&2
                ;;
        esac
    done
fi

# ── Assemble docker run args ─────────────────────────────────────────────────
DOCKER_ARGS=(
    --rm
    --name "$CONTAINER_NAME"
    --cap-add NET_ADMIN
    -v "${WORKSPACE_DIR}:/workspace"
    -v "${CLAUDE_STATE_VOLUME}:/home/devuser"
    -e HOST_UID="$(id -u)"
    -e HOST_GID="$(id -g)"
    -e TERM="${TERM:-xterm-256color}"
    -e GIT_AUTHOR_NAME="$GIT_USER_NAME"
    -e GIT_AUTHOR_EMAIL="$GIT_USER_EMAIL"
    -e GIT_COMMITTER_NAME="$GIT_USER_NAME"
    -e GIT_COMMITTER_EMAIL="$GIT_USER_EMAIL"
    -w /workspace
    --cpus 2.0
)

if $ENABLE_DOCKER; then
    DOCKER_ARGS+=(
        -e ENABLE_DOCKER=true
        --pids-limit 512
        --memory 8g
        --security-opt "seccomp=${PROJECT_DIR}/config/dind-seccomp.json"
        --security-opt "apparmor=unconfined"
        --security-opt "systempaths=unconfined"
        --device /dev/fuse
        --device /dev/net/tun
        --cap-add SYS_ADMIN
    )
else
    DOCKER_ARGS+=(
        --pids-limit 512
        --memory 4g
    )
fi

# ── Project-specific domain allowlist ───────────────────────────────────────
if [ -f "$SANDBOX_DOMAINS_FILE" ]; then
    EXTRA_DOMAINS=$(grep -v '^\s*#' "$SANDBOX_DOMAINS_FILE" | grep -v '^\s*$' | tr '\n' ' ' | sed 's/ $//')
    if [ -n "$EXTRA_DOMAINS" ]; then
        DOCKER_ARGS+=(-e "EXTRA_ALLOWED_DOMAINS=$EXTRA_DOMAINS")
    fi
fi

# ── Project-specific credential injection ───────────────────────────────────
resolve_credentials

if [ -n "$ENTRYPOINT_OVERRIDE" ]; then
    DOCKER_ARGS+=(--entrypoint "$ENTRYPOINT_OVERRIDE")
fi

# Attach TTY flags only when both stdin and stdout are a terminal.
# Checking stdout prevents stalling when output is captured (e.g. $(...)).
if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_ARGS+=(-it)
fi

# ── Run ──────────────────────────────────────────────────────────────────────
# Clean up credential temp files before exec (exec replaces the shell so EXIT
# traps don't fire — plaintext secrets must not persist on the host filesystem)
_cred_cleanup
echo "[code-sandbox] Starting sandbox in: $WORKSPACE_DIR"
exec docker run "${DOCKER_ARGS[@]}" "$IMAGE_NAME" "${CMD[@]}"
